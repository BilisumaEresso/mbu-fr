# 1. Disable MultiViews to prevent cPanel from guessing wrong file paths
Options -MultiViews

# 2. Manual HTTPS Enforcement Loop
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Force HTTPS and non-www canonical domain in a single 301 redirect hop
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://mekibatuunion.org%{REQUEST_URI} [R=301,L]

  # 3. SPA Frontend Router Fallback
  # If the file or directory exists physically, serve it directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Fallback all other URLs to index.html so React/Vue Router can parse them
  RewriteRule ^ index.html [L]
</IfModule>

# 4. Cache static assets aggressively, but not index.html
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# 5. Gzip compression for Yegara Apache server
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
