# Form submission service endpoints for Formspree or Web3Forms (POST API with JSON body).
# Copy these variables into a new .env.local file at the project root with your actual Formspree/Web3Forms IDs.

VITE_BUYERS_FORM_ENDPOINT=https://formspree.io/f/YOUR_BUYERS_FORM_ID
VITE_CONTACT_FORM_ENDPOINT=https://formspree.io/f/YOUR_CONTACT_FORM_ID
