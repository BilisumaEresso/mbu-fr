# Production & Local Form Submission Endpoints (POST API with JSON body)
# Compatible with Formspree, Web3Forms, Getform, or custom backend API.
#
# FOR LOCAL DEVELOPMENT: Copy to .env.local
# FOR PRODUCTION (cPanel): Set in .env.production before running `npm run build`
# (Vite bakes VITE_* variables directly into the compiled JavaScript at build time).

# Buyers Request-a-Quote (RFQ) Form Endpoint
VITE_BUYERS_FORM_ENDPOINT=https://formspree.io/f/YOUR_BUYERS_FORM_ID

# Contact Page General Inquiries Form Endpoint
VITE_CONTACT_FORM_ENDPOINT=https://formspree.io/f/YOUR_CONTACT_FORM_ID
